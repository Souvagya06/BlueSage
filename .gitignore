# ==============================================================================
# BlueSage — Git Ignore
# ==============================================================================

# ── Environment & Secrets ──
.env
.env.local
.env.*.local
*.env
!.env.example

# ── Python & Virtual Environments ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
env/
venv/
.venv/
backend/venv/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ── Node & Frontend ──
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
frontend/.vite/

# Frontend production build (generated via npm run build)
dist/
frontend/dist/

# ── Operating System Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ── IDE & Editors ──
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Raw Data Dumps & Archives ──
# Keep processed datasets (data/processed/) tracked!
data/raw/*.tif
data/raw/*.tiff
data/raw/*.zip
data/raw/*.tar.gz
data/raw/*.geojson
data/raw/*.parquet

# ── Logs & Temp ──
*.log
logs/
tmp/
temp/
